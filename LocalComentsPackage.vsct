  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidLocalComentsCmdSet" id="cmdidAddComment" editor="guidVSStd97" key1="C" mod1="Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidLocalComentsPackage" value="{fa17b004-5ded-4df0-91c5-278e3d4f3f9d}" />

