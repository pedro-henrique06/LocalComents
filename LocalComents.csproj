<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 'latest', not a pinned version: the manifest targets 17.14+, whose compiler predates C# 14. -->
    <LangVersion>latest</LangVersion>
    <RootNamespace>LocalComents</RootNamespace>
    <UseWPF>true</UseWPF>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <DeployExtension>true</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <!--
      This project lives at the repository root, so the SDK's default globbing would otherwise
      pull in the MCP server's sources and its generated obj/ files.
    -->
    <Compile Remove="LocalComents.Mcp\**;mcp-server\**" />
    <None Remove="LocalComents.Mcp\**;mcp-server\**" />
    <Page Remove="LocalComents.Mcp\**;mcp-server\**" />
    <EmbeddedResource Remove="LocalComents.Mcp\**;mcp-server\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.8.739" />
    <!-- Newtonsoft.Json is shipped by Visual Studio itself, so it is not copied into the VSIX. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <!--
      Shipped in the VSIX, not left to the IDE. Visual Studio does host WebView2, but its copy is
      not on the probing path an extension's assemblies resolve against: referencing this
      compile-time only produced an extension that built fine and could not load the types at
      runtime. ForceIncludeInVSIX is needed on top of that, because the VSSDK output groups
      otherwise strip assemblies the IDE also ships.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" ForceIncludeInVSIX="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- MEF attributes used by the editor components. -->
    <Reference Include="System.ComponentModel.Composition" />
    <!-- OleMenuCommandService derives from System.ComponentModel.Design.MenuCommandService. -->
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MCP server and its dependencies ship inside the VSIX under MCP\.
         Referenced for build ordering only; the files are added by AddMcpServerToVsix below. -->
    <ProjectReference Include="LocalComents.Mcp\LocalComents.Mcp.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <IncludeOutputGroupsInVSIX></IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>

  <!--
    The VSSDK output groups strip assemblies that Visual Studio itself ships (Newtonsoft.Json,
    System.Text.Json, System.Memory...). That is correct for code loaded into devenv, but the MCP
    server is a separate process and cannot resolve them from the IDE's folders — it would ship
    broken. Feed the server's build output straight into VSIXSourceItem to bypass that filtering.
  -->
  <Target Name="AddMcpServerToVsix" BeforeTargets="GetVsixSourceItems" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_McpServerOutput Include="$(MSBuildProjectDirectory)\LocalComents.Mcp\bin\$(Configuration)\net472\**\*.*"
                        Exclude="$(MSBuildProjectDirectory)\LocalComents.Mcp\bin\$(Configuration)\net472\**\*.pdb" />
      <VSIXSourceItem Include="@(_McpServerOutput)">
        <VSIXSubPath>MCP\%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Shown by the VSIX installer and the Marketplace listing; referenced by <License>. -->
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Marketplace listing artwork; referenced by <Icon>/<PreviewImage> in the manifest. -->
    <Content Include="Resources\Icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\PreviewImage.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Rendered offline by the diagram window; MermaidPage looks for it under WebView\. -->
    <Content Include="Resources\WebView\mermaid.min.js">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>WebView</VSIXSubPath>
    </Content>
  </ItemGroup>
  <!--
    WebView2Loader.dll is native, copied to the output by the WebView2 package's own targets rather
    than tracked as a reference — so ForceIncludeInVSIX does not reach it, and the managed
    Core assembly P/Invokes straight into it. Without this the VSIX ships the halves that cannot
    work alone.
  -->
  <!--
    ForceIncludeInVSIX brings the loader in under runtimes\<rid>\native, which is where a .NET
    Core host would look for it. This extension is .NET Framework, which does no RID probing at
    all — the managed Core assembly P/Invokes WebView2Loader.dll expecting it beside itself. So a
    copy goes to the VSIX root, next to the assembly that calls into it.

    No DependsOnTargets: the VSIX pipeline is itself reached from Build, so depending on Build here
    closes a cycle. By the time GetVsixSourceItems runs, the copy-to-output phase has already run.
  -->
  <Target Name="AddWebView2LoaderToVsix" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <_WebView2LoaderPath>$(OutDir)runtimes\win-x64\native\WebView2Loader.dll</_WebView2LoaderPath>
    </PropertyGroup>
    <ItemGroup>
      <VSIXSourceItem Include="$(_WebView2LoaderPath)" Condition="Exists('$(_WebView2LoaderPath)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <VSCTCompile Include="LocalComentsPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
</Project>
